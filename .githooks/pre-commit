#!/bin/sh
set -eu

added_lines=$(git diff --cached --unified=0 -- Cargo.toml Cargo.lock .cargo ':glob:**/Cargo.toml' |
    sed -n 's/^+//p')

if printf '%s\n' "$added_lines" |
    grep -Eq 'aegis-shell/tessera|path[[:space:]]*=[[:space:]]*"\.\./(tessera|arca|sigil)'; then
    printf '%s\n' \
        "Portal builds must not depend on companion source repositories (tessera, arca, sigil)." \
        "Use Portal-owned wire projections or runtime binary contracts instead."
    exit 1
fi
