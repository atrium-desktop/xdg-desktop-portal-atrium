#!/bin/sh
set -eu

added_lines=$(git diff --cached --unified=0 -- Cargo.toml Cargo.lock .cargo ':glob:**/Cargo.toml' |
    sed -n 's/^+//p')

if printf '%s\n' "$added_lines" |
    grep -Eq 'aegis-shell/tessera|path[[:space:]]*=[[:space:]]*"\.\./tessera'; then
    printf '%s\n' \
        "Portal builds must not depend on the Tessera source repository." \
        "Use the Portal-owned atrium-portal-ipc wire projection instead."
    exit 1
fi
